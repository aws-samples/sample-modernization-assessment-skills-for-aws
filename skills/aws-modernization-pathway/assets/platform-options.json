  "groups": [
    {
      "pathway": "modern-devops",
      "field": "observability_options",
      "title": "Observability suitability",
      "options": [
        {
          "id": "opentelemetry",
          "name": "OpenTelemetry / ADOT",
          "category": "telemetry",
          "question": "Verify distributed tracing and instrumentation needs, SDK/Collector/propagation compatibility, failure handling, privacy and cost",
          "additional_readiness": [
            "telemetry_compatibility",
            "pipeline_resilience"
          ],
          "source": "https://opentelemetry.io/docs/what-is-opentelemetry/"
        },
        {
          "id": "managed-grafana",
          "name": "Amazon Managed Grafana",
          "category": "visualization",
          "question": "Verify multi-source visualization needs, SSO/data source permissions, dashboard/alarm ownership and cost",
          "additional_readiness": [
            "data_source_access",
            "alert_ownership"
          ],
          "source": "https://docs.aws.amazon.com/grafana/latest/userguide/what-is-Amazon-Managed-Service-Grafana.html"
        },
        {
          "id": "managed-prometheus",
          "name": "Amazon Managed Service for Prometheus",
          "category": "metrics",
          "question": "Verify Prometheus/PromQL needs, scrape/remote-write, HA deduplication, cardinality, queries, retention and cost",
          "additional_readiness": [
            "telemetry_compatibility",
            "cardinality_capacity"
          ],
          "source": "https://docs.aws.amazon.com/prometheus/latest/userguide/what-is-Amazon-Managed-Service-Prometheus.html"
        }
      ]
    },
    {
