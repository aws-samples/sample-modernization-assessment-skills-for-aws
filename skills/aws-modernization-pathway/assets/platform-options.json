            "consumer_safety",
            "replay_recovery"
          ],
          "source": "https://docs.aws.amazon.com/eventbridge/latest/userguide/eb-what-is.html"
        },
        {
          "id": "sns",
          "name": "Amazon SNS",
          "category": "pubsub",
          "question": "Verify fan-out needs, filters, subscriber failure isolation and recovery",
          "additional_readiness": [
            "delivery_semantics",
            "consumer_safety",
            "replay_recovery"
          ],
          "source": "https://docs.aws.amazon.com/sns/latest/dg/welcome.html"
