          "additional_readiness": [
            "delivery_semantics",
            "consumer_safety",
            "replay_recovery",
            "kafka_compatibility",
            "partition_capacity"
          ],
          "source": "https://docs.aws.amazon.com/msk/latest/developerguide/what-is-msk.html"
        },
        {
          "id": "sqs",
          "name": "Amazon SQS",
          "category": "queue",
          "question": "Verify async work and buffering needs, Standard/FIFO selection, idempotency, visibility, DLQ and recovery",
